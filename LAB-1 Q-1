// Read and display all array elements.
#include <stdio.h>

int main()
{
    int arr[100], n, i;

    printf("Enter the array size: ");
    scanf("%d", &n);

    if(n <= 0)
    {
        printf("Invalid array size");
        return 0;
    }

    printf("Enter %d elements:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Array elements are:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
    return 0;
}
