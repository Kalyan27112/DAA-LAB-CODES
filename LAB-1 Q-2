// Find the Largest Element in a Given Array. 
#include <stdio.h>

int main()
{
    int arr[100], n, i, largest;

    printf("Enter the size of array: ");
    scanf("%d", &n);

    if(n <= 0)
    {
        printf("Array is empty");
        return 0;
    }

    printf("Enter %d elements:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    largest = arr[0];

    for(i = 1; i < n; i++)
    {
        if(arr[i] > largest)
        {
            largest = arr[i];
        }
    }

    printf("Largest element = %d", largest);

    printf("\nThis code is done by Kalyan Ram");

    return 0;
}
